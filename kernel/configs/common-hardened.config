# Blackwall — Shared Hardened Guest Linux Kernel Config (Linux 7.3+)
# Built with Clang/LLVM via: make LLVM=1 LLVM_IAS=1
# Merged with either loopback-tun.fragment (vmlinux-lo) or noinet.fragment (vmlinux-noinet),
# plus the target architecture fragment (x86_64.fragment or aarch64.fragment).

# Enable expert Kconfig options so IO_URING, AIO, MODIFY_LDT, X86_VSYSCALL can be compiled out
CONFIG_EXPERT=y

# ==============================================================================
# 1. Shared Socket Base (AF_UNIX + AF_VSOCK) & Disabled High-CVE Networking
# ==============================================================================
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# High-CVE networking subsystems permanently compiled out in BOTH profiles
# CONFIG_NETFILTER is not set
# CONFIG_PACKET is not set
# CONFIG_NETLINK_DIAG is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_TLS is not set
# CONFIG_XFRM is not set
# CONFIG_XFRM_USER is not set
# CONFIG_XFRM_ALGO is not set
# CONFIG_XFRM_AH is not set
# CONFIG_XFRM_ESP is not set
# CONFIG_INET6_AH is not set
# CONFIG_INET6_ESP is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_INET_TUNNEL is not set
# CONFIG_TCP_MD5SIG is not set
# CONFIG_SCTP is not set
# CONFIG_TIPC is not set
# CONFIG_RDS is not set
# CONFIG_L2TP is not set

# ==============================================================================
# 2. Attack-Surface Elimination
# ==============================================================================
# No loadable modules, no kexec, no hibernation, no raw kernel memory access
# CONFIG_MODULES is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_DEVMEM is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KALLSYMS_ALL is not set

# Disable io_uring (major kernel CVE surface)
# CONFIG_IO_URING is not set

# Disable high-risk / legacy syscall surfaces
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_AIO is not set
# CONFIG_BINFMT_MISC is not set

# Keep System V IPC isolated via CLONE_NEWIPC so local PostgreSQL starts cleanly
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y

# No swap (ephemeral tmpfs pages never spill unencrypted)
# CONFIG_SWAP is not set

# Strip hardware buses not needed in microVMs (boot speed + attack surface)
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_WLAN is not set
# CONFIG_EFI is not set

# ==============================================================================
# 3. KSPP, Clang ThinLTO, KCFI & Memory/Stack/Heap Hardening (Linux 7.3+)
# ==============================================================================
CONFIG_LTO_CLANG_THIN=y
CONFIG_CFI=y

CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_BUCKETS=y
# Partitioned kmalloc slabs: Kconfig auto-selects KMALLOC_PARTITION_TYPED on Clang 22+
# (alloc-token) and falls back to KMALLOC_PARTITION_RANDOM on Clang < 22.
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_STRICT_KERNEL_RWX=y

# ==============================================================================
# 4. Storage, Virtio, Crypto, Lockdown, Landlock, Yama & Namespaces
# ==============================================================================
# Minimal Virtio transport + devices (VIRTIO_PCI enabled in x86_64.fragment)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Embedded initramfs carrying blackwall-init & blackwall-netbridge
CONFIG_BLK_DEV_INITRD=y

# 2-Disk Model: Immutable Rootfs (vda: erofs + dm-verity) + Encrypted /workspace (vdb: dm-crypt + ext4)
# No overlayfs required for /workspace
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
# CONFIG_OVERLAY_FS is not set

# PTYs for interactive /pty sessions (Unix98 only, no legacy PTYs)
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set

# Crypto primitives for dm-crypt & dm-verity (AES-XTS + SHA256)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y

# Confidentiality Lockdown, Landlock, Yama, Seccomp & Namespaces
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="lockdown,yama,landlock"
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y

# Unprivileged user namespaces compiled out entirely (unshare(CLONE_NEWUSER) -> EINVAL)
# CONFIG_USER_NS is not set

# Optional Phase 6+ BPF LSM telemetry is explicitly excluded from MVP configs
# CONFIG_BPF_LSM is not set
# CONFIG_BPF_SYSCALL is not set
